<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:net="http://www.zfoo.com/schema/net"
       xmlns:event="http://www.zfoo.com/schema/event"
       xmlns:scheduler="http://www.zfoo.com/schema/scheduler"
       xsi:schemaLocation="
             http://www.springframework.org/schema/beans
             http://www.springframework.org/schema/beans/spring-beans.xsd
             http://www.springframework.org/schema/context
             http://www.springframework.org/schema/context/spring-context.xsd
             http://www.zfoo.com/schema/net
             http://www.zfoo.com/schema/net-1.0.xsd
             http://www.zfoo.com/schema/event
             http://www.zfoo.com/schema/event-1.0.xsd
             http://www.zfoo.com/schema/scheduler
             http://www.zfoo.com/schema/scheduler-1.0.xsd">

    <context:property-placeholder location="classpath:application.properties"/>

    <context:component-scan base-package="com.oaixdog.loginserver"/>

    <!-- provider：模块 login，provider 名 login（与模块名、服务类型一致），调用方的 consumer 填 login；consumer：连上管理后台后上报（ServerReport），事件日志发给 log（EventReport） -->
    <net:net id="login" protocol-location="protocol.xml">
        <net:registry center="zookeeper" path="${zookeeper.path}" user="" password="">
            <net:address name="zookeeper" url="${zookeeper.address}"/>
        </net:registry>
        <net:providers>
            <net:provider protocol-module="login" provider="login"/>
        </net:providers>
        <net:consumers>
            <net:consumer consumer="admin"/>
            <net:consumer consumer="log"/>
            <!-- 向游戏服要客户端连接地址，协议 ServerInfo -->
            <net:consumer load-balancer="random" consumer="daoshinvgui"/>
        </net:consumers>
    </net:net>

    <!-- 注册 @EventReceiver：AdminReportService 在连上管理后台时上报 -->
    <event:event id="eventBus"/>

    <scheduler:scheduler id="schedulerManager"/>
</beans>
