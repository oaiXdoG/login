<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<protocols>
    <module id="1" name="native">
        <protocol location="com.zfoo.net.router.attachment"/>
    </module>

    <module id="2" name="common">
        <protocol location="com.zfoo.net.packet.common.Message"/>
        <protocol location="com.zfoo.net.packet.common.Error"/>
        <protocol location="com.zfoo.net.packet.common.Heartbeat"/>
        <protocol location="com.zfoo.net.packet.common.Ping"/>
        <protocol location="com.zfoo.net.packet.common.Pong"/>
    </module>

    <!-- 服务之间的 RPC：admin 模块，登录服作为 consumer 向管理后台上报，见 protocol 工程 AGENTS.md -->
    <module id="3" name="admin">
        <protocol location="com.oaixdog.protocol.admin"/>
    </module>

    <!-- 服务之间的 RPC：log 模块，登录服作为 consumer 上报事件日志 -->
    <module id="4" name="log">
        <protocol location="com.oaixdog.protocol.log"/>
    </module>

    <!-- 客户端 HTTP 协议 -->
    <module id="5" name="login">
        <protocol location="com.oaixdog.loginserver.protocol.LoginRequest"/>
        <protocol location="com.oaixdog.loginserver.protocol.VersionRequest"/>
        <protocol location="com.oaixdog.loginserver.protocol.LoginResponse"/>
        <protocol location="com.oaixdog.loginserver.protocol.VersionResponse"/>
    </module>

    <!-- 登录服消费游戏服。ServerInfo 用来取客户端要连的 host 和 port -->
    <module id="7" name="daoshinvgui">
        <protocol location="com.oaixdog.protocol.daoshinvgui.ServerInfo"/>
        <protocol location="com.oaixdog.protocol.daoshinvgui.ServerInfoReply"/>
    </module>

</protocols>
